AGENT_SHARED_SECRET=use-the-same-long-random-secret-as-vercel

# Recommended for reliable production automation:
CODEX_API_KEY=your-openai-api-key

# Advanced alternative for a trusted private MVP only. Base64-encode the
# complete local ~/.codex/auth.json file and store it as a Railway secret.
# Never commit or paste the value into chat.
CODEX_AUTH_JSON_B64=
CODEX_HOME=/tmp/emerald-codex
